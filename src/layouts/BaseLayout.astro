---
const { title = 'Storefront' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A headless WooCommerce storefront powered by Astro." />
    <title>{title}</title>
    <style is:global>
      :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #172033; background: #f7f8fb; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      a { color: inherit; }
      .wrap { width: min(1100px, calc(100% - 40px)); margin: auto; }
      header { background: white; border-bottom: 1px solid #e6e8ef; }
      .bar { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
      .brand { font-weight: 800; font-size: 1.25rem; text-decoration: none; }
      .checkout { background: #4f46e5; color: white; border-radius: 8px; padding: 10px 15px; text-decoration: none; font-weight: 650; }
      main { padding: 54px 0 80px; }
      h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); letter-spacing: -.04em; margin: 0 0 12px; }
      .intro { color: #596276; margin: 0 0 32px; }
      .products { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
      .card { overflow: hidden; background: white; border: 1px solid #e6e8ef; border-radius: 14px; }
      .card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: #eceef4; }
      .details { padding: 16px; }
      .details h2 { font-size: 1rem; margin: 0 0 8px; }
      .price { color: #4f46e5; font-weight: 700; }
      .add-to-cart { margin-top: 14px; width: 100%; border: 0; border-radius: 8px; background: #4f46e5; color: white; padding: 10px 12px; font: inherit; font-weight: 650; cursor: pointer; }
      .add-to-cart:hover:not(:disabled) { background: #4338ca; }
      .add-to-cart:disabled { cursor: not-allowed; opacity: .55; }
      .empty { color: #596276; background: white; border: 1px solid #e6e8ef; border-radius: 12px; padding: 22px; }
      footer { padding: 24px 0; border-top: 1px solid #e6e8ef; color: #697386; font-size: .9rem; }
      @media (max-width: 600px) { .wrap { width: min(100% - 28px, 1100px); } main { padding-top: 38px; } }
    </style>
  </head>
  <body>
    <header><div class="wrap bar"><a class="brand" href="/">Your Store</a><a class="checkout" href="#" data-checkout-link aria-disabled="true">Checkout</a></div></header>
    <slot />
    <footer><div class="wrap">Powered by Astro and WooCommerce.</div></footer>
  </body>
</html>
