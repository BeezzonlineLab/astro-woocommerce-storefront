---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Your Store | Shop">
  <main class="wrap">
    <h1>Discover the collection</h1>
    <p class="intro">A fast storefront connected to your WooCommerce catalog.</p>
    <p class="empty" id="catalog-status" role="status" aria-live="polite">Loading products…</p>
    <section class="products" id="products" aria-label="Products" hidden></section>
  </main>
  <script src="/storefront.js"></script>
</BaseLayout>
